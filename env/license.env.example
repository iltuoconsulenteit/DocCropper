# License-related variables
SECRET_KEY=change-me
DATABASE_URL=sqlite+aiosqlite:///./db.sqlite3
DOCROPPER_LICENSE_KEY=YOUR-LICENSE-KEY
DOCROPPER_LICENSE_NAME=Your Name
DOCROPPER_DEV_LICENSE=YOUR-DEVELOPER-KEY
DOCROPPER_LICENSE_LEVEL=free
LICENSE_CHECK=false
LICENSE_CHECK_URL=https://tuodominio.it/index.php?option=com_fabrik&view=list&listid=XXX&format=raw  # il token viene aggiunto automaticamente
DOCROPPER_DEV_WATERMARK=false
DOCROPPER_TUNNEL=false
DOCROPPER_ENABLE_SIGN=true
DOCROPPER_ENABLE_MOBILESIGN=false
DOCROPPER_ENABLE_REMOTESIGN=false
# Optional domain used for mobile signing links when running behind proxies
DOCROPPER_PUBLIC_URL=
# Max file upload size in megabytes
DOCROPPER_MAX_UPLOAD_MB=20
