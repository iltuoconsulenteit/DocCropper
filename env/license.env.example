# License-related variables
DOCROPPER_LICENSE_KEY=YOUR-LICENSE-KEY
DOCROPPER_LICENSE_NAME=Your Name
DOCROPPER_DEV_LICENSE=YOUR-DEVELOPER-KEY
DOCROPPER_DEV_PASSWORD=87654321
DOCROPPER_LICENSE_LEVEL=free
LICENSE_CHECK=false
LICENSE_CHECK_URL=https://tuodominio.it/index.php?option=com_fabrik&view=list&listid=XXX&format=raw  # il token viene aggiunto automaticamente
DOCROPPER_DEV_WATERMARK=false
DOCROPPER_TUNNEL=false
DOCROPPER_ENABLE_SIGN=true
DOCROPPER_ENABLE_MOBILESIGN=false
DOCROPPER_ENABLE_REMOTESIGN=false
DOCROPPER_ENABLE_DOCUSEAL=false
# Enable optional plugins
DOCROPPER_ENABLE_WATERMARK=true
DOCROPPER_ENABLE_DOWNLOADPNG=true
DOCROPPER_ENABLE_PAGESELECT=true
DOCROPPER_ENABLE_COLORMODE=true
# Restrict plugins to developer licenses when set to true
DOCROPPER_SIGN_DEV_ONLY=false
DOCROPPER_MOBILESIGN_DEV_ONLY=false
DOCROPPER_REMOTESIGN_DEV_ONLY=true
DOCROPPER_DOCUSEAL_DEV_ONLY=true
DOCROPPER_DOWNLOADPNG_DEV_ONLY=true
DOCROPPER_PAGESELECT_DEV_ONLY=false
DOCROPPER_COLORMODE_DEV_ONLY=false
DOCROPPER_REMOVEBG_DEV_ONLY=false
DOCROPPER_COMPRESSPDF_DEV_ONLY=false
DOCROPPER_WATERMARK_DEV_ONLY=false
DOCROPPER_CROP_DEV_ONLY=false
DOCROPPER_SPONSORFRAME_DEV_ONLY=false
DOCROPPER_LOGIN_DEV_ONLY=true
# Limit for LAN users when the optional LAN plugin is enabled
DOCROPPER_LAN_USER_LIMIT=0
# Optional domain used for mobile signing links when running behind proxies
DOCROPPER_PUBLIC_URL=
# Max file upload size in megabytes
DOCROPPER_MAX_UPLOAD_MB=5
