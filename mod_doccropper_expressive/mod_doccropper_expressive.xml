<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="4.0" client="site" method="upgrade">
  <name>mod_doccropper_expressive</name>
  <version>1.0.0</version>
  <description>DocCropper Expressive module</description>
  <files>
    <filename module="mod_doccropper_expressive">mod_doccropper_expressive.php</filename>
    <folder>tmpl</folder>
  </files>
  <media destination="doccropper">
    <folder>media</folder>
  </media>
  <config>
    <fields name="params">
      <fieldset name="basic">
        <field name="endpoint_export" type="text" label="Export Endpoint" default="/api/export" />
        <field name="endpoint_download" type="text" label="Download Endpoint" default="/api/export/download" />
        <field name="endpoint_sign" type="text" label="Sign Endpoint" default="/api/sign" />
      </fieldset>
    </fields>
  </config>
</extension>
